{
  "$description": "Type system. Modular scale, ratio 1.2 (minor third) off a 1rem base — restrained, prose-first. Families use OS/system stacks so nothing is fetched over the network (keeps pages fast, honors the no-tracking posture). `measure` caps prose line length.",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "SF Mono",
          "JetBrains Mono",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "normal": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "0": { "$type": "dimension", "$value": "0.833rem" },
      "1": { "$type": "dimension", "$value": "1rem" },
      "2": { "$type": "dimension", "$value": "1.2rem" },
      "3": { "$type": "dimension", "$value": "1.44rem" },
      "4": { "$type": "dimension", "$value": "1.728rem" },
      "5": { "$type": "dimension", "$value": "2.074rem" },
      "6": { "$type": "dimension", "$value": "2.488rem" }
    },
    "leading": {
      "tight": { "$type": "number", "$value": 1.2 },
      "snug": { "$type": "number", "$value": 1.4 },
      "normal": { "$type": "number", "$value": 1.6 }
    },
    "tracking": {
      "tight": { "$type": "dimension", "$value": "-0.01em" },
      "normal": { "$type": "dimension", "$value": "0" },
      "wide": { "$type": "dimension", "$value": "0.02em" }
    }
  },
  "measure": { "$type": "dimension", "$value": "66ch" }
}
