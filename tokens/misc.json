{
  "$description": "Radii, borders, shadows, z-index, breakpoints. Gruvbox is a flat scheme — radii and shadows are intentionally restrained. Breakpoints are emitted as custom properties so JS/container queries can read the same source values.",
  "radius": {
    "none": { "$type": "dimension", "$value": "0" },
    "sm": { "$type": "dimension", "$value": "2px" },
    "md": { "$type": "dimension", "$value": "4px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "border": {
    "width": {
      "thin": { "$type": "dimension", "$value": "1px" },
      "thick": { "$type": "dimension", "$value": "2px" }
    }
  },
  "shadow": {
    "$description": "Low-opacity black, scheme-independent. Subtle by design; most panels rely on borders, not elevation.",
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(0, 0, 0, 0.12)" },
    "md": { "$type": "shadow", "$value": "0 2px 8px rgba(0, 0, 0, 0.16)" }
  },
  "z": {
    "base": { "$type": "number", "$value": 0 },
    "raised": { "$type": "number", "$value": 10 },
    "sticky": { "$type": "number", "$value": 100 },
    "overlay": { "$type": "number", "$value": 1000 }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "40rem" },
    "md": { "$type": "dimension", "$value": "48rem" },
    "lg": { "$type": "dimension", "$value": "64rem" },
    "xl": { "$type": "dimension", "$value": "80rem" }
  }
}
